# Python
__pycache__/
*.py[cod]
.venv/

# Local SQLite DB is generated/derived. The CSVs in data/ are the data store and
# may be committed as an off-machine backup (the collector runs on the workstation).
*.db

# csv_tool.py's pre-write safety backups — local recovery only, not for git history.
*.csv.bak.*

